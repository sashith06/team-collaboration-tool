# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
# node_modules contains all installed packages (can be 100MB+)
# Anyone can recreate it by running: npm install
node_modules/

# ─────────────────────────────────────────────
# Environment Variables
# ─────────────────────────────────────────────
# .env holds secrets like DB connection strings, JWT keys, API keys
# NEVER commit this — it exposes credentials to anyone with repo access
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
# Runtime & OS files
# ─────────────────────────────────────────────
# Process ID file created by some Node.js apps
*.pid
*.seed
*.pid.lock

# macOS folder metadata
.DS_Store

# Windows thumbnail cache
Thumbs.db

# ─────────────────────────────────────────────
# Build outputs (if you ever add a build step)
# ─────────────────────────────────────────────
dist/
build/

# ─────────────────────────────────────────────
# Editor / IDE files
# ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
